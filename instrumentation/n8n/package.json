{
  "name": "n8n-nodes-otel-trace",
  "version": "1.0.0",
  "description": "OpenTelemetry spans for n8n workflows — tool latency, token cost and citation coverage for every AI step",
  "keywords": [
    "n8n-community-node-package",
    "opentelemetry",
    "observability",
    "ai-agent",
    "tracing"
  ],
  "license": "MIT",
  "homepage": "https://github.com/therealfullmetal55555/observability-stack",
  "author": {
    "name": "therealfullmetal55555"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint nodes shared --ext .ts",
    "test": "jest"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/OtelCollectorApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/OtelTrace/OtelTrace.node.js",
      "dist/nodes/OtelTrace/OtelTraceEnd.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-trace-node": "^1.26.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.48.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
