# Custom collector: contrib components + the local tokencost processor.
#
# Multi-stage so the final image is a single static binary on distroless —
# a collector that has to phone home for libc is a collector that fails during
# an incident.

FROM golang:1.22-bookworm AS builder

ARG OCB_VERSION=0.106.1

WORKDIR /build

RUN go install go.opentelemetry.io/collector/cmd/builder@v${OCB_VERSION}

COPY otel-collector/builder-config.yaml ./builder-config.yaml
COPY otel-collector/processor ./processor

# Module cache warm, then build. Kept as two steps so editing the processor
# doesn't re-download the whole contrib tree.
RUN cd processor && go mod download && go vet ./... || true
RUN builder --config=builder-config.yaml

# ---------------------------------------------------------------------------

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /build/otel-collector/dist/otelcol-ai /otelcol-ai
COPY otel-collector/config.yaml /etc/otelcol/config.yaml

USER nonroot:nonroot

EXPOSE 4317 4318 8888 13133

ENTRYPOINT ["/otelcol-ai"]
CMD ["--config=/etc/otelcol/config.yaml"]
