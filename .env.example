# Copy to .env and fill in. docker compose picks this up automatically.

# --- where telemetry goes ---------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
SERVICE_NAME=rag-support-bot
SERVICE_VERSION=1.0.0
ENVIRONMENT=production

# 1.0 = keep every trace. Drop to 0.1 in prod once volume hurts,
# and keep error traces with tail_sampling in otel-collector/config.yaml.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# --- grafana ----------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
GF_SERVER_ROOT_URL=http://localhost:3000

# --- alert routing ----------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
ALERT_EMAIL_TO=team@yourdomain.com
SMTP_PASSWORD=
PAGERDUTY_KEY=

# --- spend guardrails -------------------------------------------------------
# Used by the budget gauge on the token-economics dashboard.
MONTHLY_BUDGET_USD=500
# Alert when a 1h window exceeds this multiple of the trailing 24h average.
COST_SPIKE_MULTIPLIER=3

# --- retention --------------------------------------------------------------
PROMETHEUS_RETENTION=30d
TEMPO_TRACE_RETENTION=168h
LOKI_RETENTION=168h
